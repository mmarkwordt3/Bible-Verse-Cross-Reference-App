{
  "name": "scripture-index",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run reviews:queue",
    "dev": "vite",
    "prebuild": "npm run reviews:queue",
    "build": "npm run verify:data && vite build",
    "preview": "vite preview",
    "data:refresh": "npm run douay:refresh && npm run openbible:refresh && npm run quotations:refresh && npm run greek-reuse:refresh",
    "data:build": "npm run douay:build && npm run openbible:build && npm run quotations:build && npm run greek-reuse:build",
    "data:audit": "node scripts/validate-data.mjs && npm run openbible:audit && npm run quotations:audit && npm run greek-reuse:audit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run reviews:validate && npm run data:audit && npm run verify:data",
    "verify:data": "node scripts/verify-data-files.mjs public",
    "verify:dist": "node scripts/verify-data-files.mjs dist",
    "douay:refresh": "node scripts/build-data.mjs --refresh",
    "douay:build": "node scripts/build-data.mjs",
    "openbible:refresh": "node scripts/build-openbible-data.mjs --refresh",
    "openbible:build": "node scripts/build-openbible-data.mjs",
    "openbible:audit": "node scripts/validate-openbible.mjs",
    "verify:openbible": "node scripts/verify-data-files.mjs public openbible",
    "verify:openbible-dist": "node scripts/verify-data-files.mjs dist openbible",
    "quotations:refresh": "node scripts/build-quotations-data.mjs --refresh",
    "quotations:build": "node scripts/build-quotations-data.mjs",
    "quotations:audit": "node scripts/validate-quotations.mjs",
    "verify:quotations": "node scripts/verify-data-files.mjs public quotations",
    "verify:quotations-dist": "node scripts/verify-data-files.mjs dist quotations",
    "greek-reuse:refresh": "node scripts/build-greek-reuse-data.mjs --refresh",
    "greek-reuse:build": "node scripts/build-greek-reuse-data.mjs",
    "greek-reuse:audit": "node scripts/validate-greek-reuse.mjs",
    "verify:greek-reuse": "node scripts/verify-data-files.mjs public greek-reuse",
    "verify:greek-reuse-dist": "node scripts/verify-data-files.mjs dist greek-reuse",
    "reviews:queue": "node scripts/build-greek-review-queue.mjs",
    "reviews:validate": "node scripts/validate-greek-reuse-reviews.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  }
}
